<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane fx:controller="org.example.bmicalculatordemo.BMICalculatorController"
            prefHeight="631.0" prefWidth="339.0"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <VBox layoutX="0.0" prefHeight="631.0" prefWidth="339.0">
         <children>
            <Label text="BMI and BMR calculator" prefHeight="40.0" prefWidth="340.0">
               <font><Font name="System Bold" size="24.0"/></font>
               <VBox.margin><Insets bottom="15.0" left="15.0" right="15.0" top="15.0"/></VBox.margin>
            </Label>

            <Label text="Gender:">
               <VBox.margin><Insets bottom="10.0" left="15.0" right="15.0" top="10.0"/></VBox.margin>
            </Label>
            <HBox prefHeight="23.0" prefWidth="310.0">
               <children>
                  <RadioButton fx:id="maleRadio" text="Male">
                     <HBox.margin><Insets left="15.0" right="15.0"/></HBox.margin>
                  </RadioButton>
                  <RadioButton fx:id="femaleRadio" text="Female"/>
               </children>
            </HBox>

            <Label text="Weight (kg):">
               <VBox.margin><Insets bottom="5.0" left="15.0" right="15.0" top="15.0"/></VBox.margin>
            </Label>
            <TextField fx:id="weightField" promptText="Example: 75">
               <VBox.margin><Insets left="15.0" right="15.0"/></VBox.margin>
            </TextField>

            <Label text="Height (cm):">
               <VBox.margin><Insets bottom="5.0" left="15.0" right="15.0" top="15.0"/></VBox.margin>
            </Label>
            <TextField fx:id="heightField" promptText="Example: 180">
               <VBox.margin><Insets left="15.0" right="15.0"/></VBox.margin>
            </TextField>

            <Label text="Age:">
               <VBox.margin><Insets bottom="5.0" left="15.0" right="15.0" top="15.0"/></VBox.margin>
            </Label>
            <TextField fx:id="ageField" promptText="Example: 25">
               <VBox.margin><Insets left="15.0" right="15.0"/></VBox.margin>
            </TextField>

            <Button text="Calculate BMI and BMR"
                    onAction="#onCalculateClick"
                    prefHeight="26.0" prefWidth="309.0">
               <font><Font size="16.0"/></font>
               <VBox.margin><Insets bottom="15.0" left="15.0" right="15.0" top="15.0"/></VBox.margin>
            </Button>

            <Separator prefWidth="200.0"/>

            <Label text="BMI:">
               <font><Font size="16.0"/></font>
               <VBox.margin><Insets left="15.0" right="15.0" top="15.0"/></VBox.margin>
            </Label>
            <Label fx:id="bmiResultLabel">
               <font><Font name="System Bold" size="16.0"/></font>
               <VBox.margin><Insets left="15.0"/></VBox.margin>
            </Label>

            <Label text="BMR:">
               <font><Font size="16.0"/></font>
               <VBox.margin><Insets left="15.0" right="15.0" top="15.0"/></VBox.margin>
            </Label>
            <Label fx:id="bmrResultLabel">
               <font><Font name="System Bold" size="16.0"/></font>
               <VBox.margin><Insets bottom="15.0" left="15.0"/></VBox.margin>
            </Label>

            <Separator prefWidth="200.0"/>

            <Button text="View BMI Chart →"
                    onAction="#onShowChartClick"
                    prefHeight="26.0" prefWidth="309.0">
               <font><Font name="System Bold" size="16.0"/></font>
               <VBox.margin><Insets bottom="15.0" left="15.0" right="15.0" top="15.0"/></VBox.margin>
            </Button>
         </children>
         <padding><Insets bottom="15.0" left="15.0" right="15.0" top="15.0"/></padding>
      </VBox>
   </children>
</AnchorPane>